# REQUIRED in anything reachable from outside your machine.
# Session tokens are HMAC'd with this; without it the server falls back to a
# known default, tokens become forgeable, and terminal write access (a shell
# on this machine) is open to anyone. Generate with: openssl rand -hex 32
SESSION_SECRET=

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Builder D fills these in
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
